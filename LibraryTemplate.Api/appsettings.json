{
  "Auth0": {
    "Domain": "https://your-tenant.auth0.com/",
    "Audience": "https://library-template-api"
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=library_template;Username=postgres;Password=postgres"
  },
  "Email": {
    "FromAddress": "library@example.test"
  },
  "BackgroundJobs": {
    "EnableOverdueReminders": false,
    "OverdueReminderIntervalSeconds": 300,
    "OverdueReminderBatchSize": 50
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
